pipeline {
  ageny any
  environment {
    IMAGE_NAME = 'ayushviz/test-jenkins'
  }
  stages {
    stage('Checkout') {
      steps {
        git branch 'main', url: "https://github.com/ayushviz/test-jenkins"
      }
    }
    stage('Build Docker Image') {
      steps {
        bat "docker build -t %IMAGE_NAME%:latest ."
      }
    }
    stage('Push to Dockerhub') {
      steps {
        withCredentials([usernamePassword(credentialId: 'docker', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          bat ""
          "
          echo % DOCKER_PASS % |
            docker login - u % DOCKER_USER % --password - stdin
          docker push % IMAGE_NAME %: latest
          docker logout
            ""
          "
        }
      }
    }
  }
}
